ADD_FLAGS = 


# GMT4 
GGRD_INC_FLAGS = -I$(GMT4HOME)/include -I$(NETCDFHOME)/include -DUSE_GMT4
#
# the GMT and netcdf libraries are only linked into the GMT based
# tools, see GGRD_LIBS_LINKLINE in the Makefile. The hc binaries do not
# need them.
LDFLAGS =
