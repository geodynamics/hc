#!/bin/bash
#
# hc installation directory and binaries: this script lives in
# $hcdir/tools and can be run from anywhere, e.g. as tools/calc_rms
# from the main hc directory, as long as the code has been compiled
# with make (binaries in $hcdir/bin)
#
hcdir=`cd \`dirname $0\`/..; pwd`
PATH=$hcdir/bin:$hcdir/tools:$PATH
#
# helper functions (replacing the lc and oneline utilities)
#
lc(){				# number of lines in a file
    gawk 'END{print(NR)}' $1
}
oneline(){			# print line $1 of file $2
    gawk -v n=$1 'NR==n' $2
}
# compute RMS of GMT grd velocities
# (needs grd2wvarrms and togformat.awk, which are not part of hc)
models=${1-"med1_fs"}

nl=`lc vdepth.dat`
i=1
rm rms.dat 2> /dev/null
while [ $i -le $nl ];do
    grdmath vt.$i.grd vp.$i.grd R2 SQRT = tmp.h.grd
    echo `oneline $i vdepth.dat | gawk -f togformat.awk` \
                `grd2wvarrms vr.$i.grd` `grd2wvarrms tmp.h.grd`  >> rms.dat
    rm tmp.h.grd
    tail -1 rms.dat
    ((i=i+1))
done
