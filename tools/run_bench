#!/bin/bash
#
# hc installation directory and binaries: this script lives in
# $hcdir/tools and can be run from anywhere, e.g. as tools/run_bench
# from the main hc directory, as long as the code has been compiled
# with make (binaries in $hcdir/bin)
#
hcdir=`cd \`dirname $0\`/..; pwd`
PATH=$hcdir/bin:$hcdir/tools:$PATH
#
# run simple benchmarks (legacy, expects bench/*/new/ directories
# with input files, which are not part of the repository)
#
tc=1
for t in pmd pm f;do
    if [ $tc -eq 1 ];then
	scale=0.2;free=""
    elif [ $tc -eq 2 ];then
	scale=0.0;free=""
    else
	scale=0.2;free="-fs"
    fi
    cd bench/$t/new/
    hc	-ds $scale $free	# run code
    hc2gmt			# convert to GMT grd (in $hcdir/tools)
    calc_rms			# compute the RMS of radial and horizontal flow


    cd -
    ((tc=tc+1))
done

